import java.util.*;
import java.sql.*;

public class libExer {
    static final String JDBC_DRIVER = "oracle.jdbc.driver.OracleDriver";
    static final String DB_URL = "jdbc:oracle:thin:@172.16.16.50:1521:ORACLE21C";
    static final String USER = "C##24BCS105";
    static final String PASS = "C##24BCS105";

    public static void main(String[] args) {
        Connection conn = null;
        Statement stmt = null;
        Scanner sc = new Scanner(System.in);

        try {
            Class.forName(JDBC_DRIVER);
            conn = DriverManager.getConnection(DB_URL, USER, PASS);
            stmt = conn.createStatement();

            // Corrected SQL syntax for CREATE TABLE
            String sql = "CREATE TABLE LIBRA ("
                    + "accNo NUMBER PRIMARY KEY, "
                    + "title VARCHAR2(30) NOT NULL, "
                    + "author VARCHAR2(30) NOT NULL, "
                    + "publisher VARCHAR2(30) NOT NULL, "
                    + "location VARCHAR2(30) NOT NULL)";
            try {
                stmt.executeUpdate(sql); // Use executeUpdate for DDL statements
            } catch (SQLException e) {
                // Table might already exist, ignore or handle as needed
                System.out.println("Table LIBRA might already exist, skipping creation.");
            }

            System.out.println("1. ADD BOOK \n2. DISPLAY BOOK \n3. REMOVE");
            System.out.println("Enter the choice:");
            int choice = sc.nextInt();
            sc.nextLine(); // consume newline left from nextInt()

            if (choice == 1) {
                System.out.println("Enter the access number:");
                int accNo = sc.nextInt();
                sc.nextLine(); // consume newline left from nextInt()

                System.out.println("Enter the book title:");
                String title = sc.nextLine();

                System.out.println("Enter the book author:");
                String author = sc.nextLine();

                System.out.println("Enter the book publisher:");
                String publisher = sc.nextLine();

                System.out.println("Enter the book location:");
                String location = sc.nextLine();

                // Use PreparedStatement to avoid SQL syntax and injection issues
                String sql1 = "INSERT INTO LIBRA (accNo, title, author, publisher, location) VALUES (?, ?, ?, ?, ?)";
                PreparedStatement pstmt = conn.prepareStatement(sql1);
                pstmt.setInt(1, accNo);
                pstmt.setString(2, title);
                pstmt.setString(3, author);
                pstmt.setString(4, publisher);
                pstmt.setString(5, location);

                int r2 = pstmt.executeUpdate();
                if (r2 > 0) {
                    System.out.println("Book details added successfully");
                } else {
                    System.out.println("Book not added");
                }
                pstmt.close();

            } else if (choice == 2) {
                String sql2 = "SELECT * FROM LIBRA";
                ResultSet r3 = stmt.executeQuery(sql2);
                while (r3.next()) {
                    int access = r3.getInt("accNo");
                    String bTitle = r3.getString("title");
                    String bAuthor = r3.getString("author");
                    String bPublisher = r3.getString("publisher");
                    String bLocation = r3.getString("location");
                    System.out.println("--------------------------------");
                    System.out.println("Access number: " + access);
                    System.out.println("Title: " + bTitle);
                    System.out.println("Author: " + bAuthor);
                    System.out.println("Publisher: " + bPublisher);
                    System.out.println("Location: " + bLocation);
                    System.out.println("--------------------------------");
                }
                r3.close();
            } else if (choice ==3){
               System.out.println("Enter accNO:");
               int accNo = sc.nextInt();
               String sql3 = "DELETE FROM LIBRA WHERE accNo = ?";
               PreparedStatement pstmt = conn.prepareStatement(sql3);
               pstmt.setInt(1, accNo);
               int r4=pstmt.executeUpdate();
               if(r4>0){
                  System.out.println("*****Removed*****");
               }
               else{
                  System.out.println("****Failed****");
               }
            }else {
                System.out.println("Invalid choice");
            }

            stmt.close();
            conn.close();
            sc.close();

        } catch (Exception e) {
            System.out.println("Exception occurred: " + e.getMessage());
            e.printStackTrace();
        }
    }
}

