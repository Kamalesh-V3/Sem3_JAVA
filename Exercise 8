package Jav;

class CounterIncreFir implements Runnable {
    public static volatile int count = 1;

    public void run() {
        for (int i = 1; i <= 1000000; i++) {
            count++;
        }
        System.out.println("Now Incrementing was Finished");
    }
}

class CounterPrintFir extends CounterIncreFir implements Runnable{
    public void run() {
        while (count<=1000000) {
            System.out.println(count);
        }
        System.out.println("Now Printing was Finished");
    }
}
public class ThreadCounterPgm {
    public static void main(String[] args) {

        CounterIncreFir c = new CounterIncreFir();
        CounterPrintFir cp = new CounterPrintFir();

        Thread t1 = new Thread(c);
        Thread t2 = new Thread(cp);

        t1.start();
        System.out.println(Thread.currentThread().getName());
        t2.start();
        System.out.println(Thread.currentThread().getName());
    }
}

