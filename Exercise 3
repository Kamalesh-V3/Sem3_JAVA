                brand=sc.nextLine();
                System.out.println("Enter model  : ");
                model=sc.nextLine();
                System.out.println("Enter price  : ");
                price=sc.nextInt();
                System.out.println("Enter gears  : ");
                gears=sc.nextInt();
                System.out.println("Enter fuel  : ");
                fuel=sc.next();
                System.out.println("Enter mileage  : ");
                mileage=sc.nextFloat();
                System.out.println("Enter the cc : ");
