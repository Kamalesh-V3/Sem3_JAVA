import java.util.Scanner;

class Employee {
   String empName;
   int empId;
   String empAddr;
   int empMobno;
   String empEmail;
   float empBasicPay;

   public void getEmployee() {
   Scanner in = new Scanner(System.in);
   System.out.println("Enter Employee Name: ");
   empName = in.nextLine();
   System.out.println("Enter Employee Id: ");
   empId = in.nextInt();
   System.out.println("Enter Employee Address: ");
   empAddr = in.next();
   System.out.println("Enter Mobile Number :");
   empMobno = in.nextInt();
   System.out.println("Enter Email :");
   empEmail = in.next();
   System.out.println("Enter Basic pay:");
   empBasicPay = in.nextFloat();
   }

   public void computeSalary() {
      float dA = 0.97f * empBasicPay;
      float hrA = 0.10f * empBasicPay;
      float pF = 0.12f * empBasicPay;
      float clubFund = 0.001f * empBasicPay;
      double grossSalary = empBasicPay + dA + hrA;
      double netSalary = grossSalary - pF - clubFund;
      System.out.println("Dearness Allowance:" + dA);
      System.out.println("HouseRent Allowance:" + hrA);
      System.out.println("Provident Fund :" + pF);
      System.out.println("Club Funds :" + clubFund);
      System.out.println("Gross Salary :" + grossSalary);
      System.out.println("Net salary :" + netSalary);
   }

   public void putEmployee() {
      System.out.println("----------Payslip----------");
      System.out.println("Employee Name :" + empName);
      System.out.println("Employee ID :" + empId);
      System.out.println("Employee Address:" + empAddr);
      System.out.println("Employee Mobile:" + empMobno);
      System.out.println("Employee Email:" + empEmail);
      System.out.println("Basic Pay:" + empBasicPay);
   }
}

public class Employeepgm {
   public static void main(String[] args) {
      Employee e = new Employee();
      e.getEmployee();
      e.putEmployee();
      e.computeSalary();
   }
}

