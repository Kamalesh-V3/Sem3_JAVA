import java.util.Scanner;

public class LongPalin {
	public static void main(String[] args) {
		String s;
		int l;
		int maxl=0;
		String max="";
		Scanner sc = new Scanner(System.in);
		System.out.println("Enter String: ");
		s=sc.nextLine();
		int n=s.length();
		for (int i=0;i<n+1;i++) {
			for (int j=i+2;j<n+1;j++) {
				String temp=s.substring(i,j);
				String sub=new StringBuffer(temp).reverse().toString();
				l=temp.length();
				if (l>maxl && sub.equals(temp)) {
				    max=temp;
					maxl=l;
				}
				else {
					continue;
				}
			}
		}
		System.out.println("Long Palindrome is: " + max);
		sc.close();
	}
}

