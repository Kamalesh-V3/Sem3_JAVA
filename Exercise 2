import java.util.Scanner;

class Matrix {
	int[][] matrixA;
	int[][] matrixB;
	int[][] resultM;
	int rowA;
	int colA;
	int rowB;
	int colB;
	
	Scanner sc=new Scanner(System.in);
	
	public void getDetails() {
		System.out.println("Enter rows and columns of matrixA:");
		rowA=sc.nextInt();
		colA=sc.nextInt();
		System.out.println("Enter rows and columns of matrixB: ");
		rowB=sc.nextInt();
		colB=sc.nextInt();
		
		matrixA=new int[rowA][colA];
		matrixB=new int[rowB][colB];
		resultM=new int[rowA][colB];
	}
	
	public void getElements() {
		System.out.println("Enter matrixA elements: ");
		for(int i=0;i<rowA;i++) {
			for(int j=0;j<colA;j++) {
				matrixA[i][j]=sc.nextInt();
			}
		}
		System.out.println("Enter matrixB elements: ");
		for(int i=0;i<rowB;i++) {
			for(int j=0;j<colB;j++) {
				matrixB[i][j]=sc.nextInt();
			}
		}
	}
	
	public void multiplyMatrix() {
		if(colA==rowB) {
			for(int i=0;i<rowA;i++) {
				for(int j=0;j<colB;j++) {
					for(int k=0;k<colA;k++) {
						resultM[i][j]+=matrixA[i][k]*matrixB[k][j];
					}
				}
			}
		}
		else {
			System.out.println("Matrix multiplication is not possible as colA!=rowB");
		}
	}
	
	public void showMatrix() {
		if (colA==rowB) {
			System.out.println("Multiplied Result Matrix is: ");
		    for(int i=0;i<rowA;i++) {
			    for(int j=0;j<colB;j++) {
				    System.out.print(resultM[i][j]+"\t");
			    }
			    System.out.println();
		    }
		}
	}
}
public class MatrixMain {
	public static void main(String[] args) {
		Matrix m=new Matrix();
		m.getDetails();
		m.getElements();
		m.multiplyMatrix();
		m.showMatrix();
	}
}

