package Jav;

import java.util.*;

class CalculateSum{
	public static double calculate(List<? extends Number>l) {
		double sum=0.0;
		for(Number i:l) {
			sum+=i.doubleValue();
		}
		return sum;
	}
}
public class CalculateSumPgm {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		List<Integer> l=new ArrayList<Integer>();
		Scanner sc=new Scanner(System.in);
		System.out.println("Enter the 'n' Value : ");
		int n=sc.nextInt();
		System.out.println("Enter the elements : ");
		for( int i=0; i<n; i++) {
			int ele=sc.nextInt();
			l.add(ele);
		}
		double sum=CalculateSum.calculate(l);
		System.out.println("Sum : "+sum);
		sc.close();
	}

}

