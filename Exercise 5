//abstract class "Shape"

public abstract class Shape {

        public String skind;

        public Shape(String skind) {
                this.skind=skind;
        }
        public void display() {
                System.out.println("Shape     : "+skind);
                System.out.println("Area      : "+areaCal());
                System.out.println("Perimeter : "+perimCal());
        }
        public abstract float areaCal();
        public abstract float perimCal();
}

//Derived class "Rectangle"

public class Rectangle extends Shape {
        public float l,w;
        public Rectangle(String skind,float l,float w) {
                super(skind);
                this.l=l;
                this.w=w;
        }
        @Override
        public float areaCal() {
                return (l*w);
        }
        @Override
        public float perimCal() {
                return (l+w)*2;
        }
}

//Derived class "Circle"

package Sem3.Exer5;

public class Circle extends Shape {
        public float r;
        public Circle(String skind,float r) {
                super(skind);
                this.r=r;
        }

        @Override
        public float areaCal() {
                float res = 3.14f*r*r;
                return res;
        }

        @Override
        public float perimCal() {
                float res= 3.14f*2*r;
                return res;
        }

}

//Derived class "Triangle"

package Sem3.Exer5;

public class Triangle extends Shape {
        public float b,h,s1,s2,s3;

        public Triangle(String skind,float b,float h,float s1, float s2, float s3) {
                super(skind);
                this.b=b;
                this.h=h;
                this.s1=s1;
                this.s2=s2;
                this.s3=s3;
        }

        @Override
        public float areaCal() {
                float res=b*h/2;
                return res;
        }

        @Override
        public float perimCal() {
                float res=s1+s2+s3;
                return res;
        }

}

